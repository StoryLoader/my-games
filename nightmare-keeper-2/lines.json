[
 {
  "id": "h1",
  "who": "haru",
  "text": "오늘 밤은, 제가 지킬게요."
 },
 {
  "id": "n1",
  "who": "narrator",
  "text": "등불을 넘겨받은 첫 밤이었습니다.",
  "asr": "등부를 넘겨받은 첫 밤이었습니다."
 },
 {
  "id": "n2",
  "who": "narrator",
  "text": "탑에는 어젯밤 되찾은 악몽들이 새 등불 속에 잠들어 있었고, 노을 할머니는 평생 처음으로 깊이 자고 있었습니다."
 },
 {
  "id": "n3",
  "who": "narrator",
  "text": "하루는 할머니가 하던 대로, 골목을 돌며 나방들을 불러 모았습니다."
 },
 {
  "id": "h2",
  "who": "haru",
  "text": "더는… 못 담겠어."
 },
 {
  "id": "n4",
  "who": "narrator",
  "text": "작은 등불은 금세 가득 찼고, 유리에 금이 갔습니다.",
  "asr": "작은 등불은 금세 가득 찾고 유리의 금이 갔습니다."
 },
 {
  "id": "h3",
  "who": "haru",
  "text": "너도… 무서웠구나."
 },
 {
  "id": "n5",
  "who": "narrator",
  "text": "하루가 따뜻한 불빛에 비춰 주자, 나방은 반딧불이 되었습니다."
 },
 {
  "id": "n6",
  "who": "narrator",
  "text": "그리고 자기가 나온 창문으로 날아 돌아갔습니다."
 },
 {
  "id": "h4",
  "who": "haru",
  "text": "가두지 않아도 돼. 돌려보내면 되는 거야."
 },
 {
  "id": "n7",
  "who": "narrator",
  "text": "그 밤, 마을의 악몽들은 하나씩 반딧불이 되어 집으로 돌아갔습니다."
 },
 {
  "id": "n8",
  "who": "narrator",
  "text": "탑에 갇혀 있던 오래된 악몽들까지도."
 },
 {
  "id": "k1",
  "who": "noeul",
  "text": "…이런 방법이, 있었구나."
 },
 {
  "id": "n9",
  "who": "narrator",
  "text": "새벽, 첫 밤을 지킨 파수꾼은 탑 계단에서 잠이 들었습니다.",
  "asr": "새벽 첫 밤을 지킨 파숙군은 탑 계단에서 잠이 들었습니다."
 },
 {
  "id": "k2",
  "who": "noeul",
  "text": "푹 자거라. 이번엔, 내가 지키마."
 }
]