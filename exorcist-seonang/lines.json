[
 {
  "id": "k1",
  "who": "boss",
  "text": "벌써 세 명째예요. 저 나무에 굴착기 삽만 닿으면, 기사가 그대로 쓰러진다니까요."
 },
 {
  "id": "s1",
  "who": "seoha",
  "text": "나무 귀신이라… 방울 몇 번 흔들고 끝내죠."
 },
 {
  "id": "m1",
  "who": "mujin",
  "text": "이건 서낭나무야. 오백 년을 이 동네를 지켜 온 나무다. 함부로 쫓을 게 아니야."
 },
 {
  "id": "s2",
  "who": "seoha",
  "text": "전 신 안 받는 무당이에요. 쫓고, 돈 받고, 끝."
 },
 {
  "id": "m2",
  "who": "mujin",
  "text": "오백 년 전 흉년에 굶어 죽은 넋들이다. 저 나무가 여태 누르고 있었던 게야."
 },
 {
  "id": "s3",
  "who": "seoha",
  "text": "소장님, 공사 멈춰요. 저 나무 뽑으면 안 돼요."
 },
 {
  "id": "k2",
  "who": "boss",
  "text": "공사가 벌써 열흘이나 밀렸어요. 오늘 밤에 뽑습니다."
 },
 {
  "id": "k3",
  "who": "boss",
  "text": "저… 저게, 다 뭐야."
 },
 {
  "id": "m3",
  "who": "mujin",
  "text": "다들 물러나! 여긴 내가 막는다!"
 },
 {
  "id": "s4",
  "who": "seoha",
  "text": "방울이… 안 들어."
 },
 {
  "id": "m4",
  "who": "mujin",
  "text": "다시 누르려면, 나무 대신 신을 모실 몸이 있어야 한다."
 },
 {
  "id": "s5",
  "who": "seoha",
  "text": "신을 받으라고요? 평생 그것만은 피해 왔는데."
 },
 {
  "id": "m5",
  "who": "mujin",
  "text": "신을 모시려면 작두를 타야 한다. 여기 날은… 저것뿐이다."
 },
 {
  "id": "s6",
  "who": "seoha",
  "text": "오세요. 제가 모실게요."
 },
 {
  "id": "g1",
  "who": "seoha",
  "text": "물러가라. 배고픈 것들아, 이제 그만 잠들어라."
 },
 {
  "id": "k4",
  "who": "boss",
  "text": "설계를 바꾸겠습니다. 저 나무는… 단지 한가운데 둡시다."
 },
 {
  "id": "s7",
  "who": "seoha",
  "text": "이제 진짜 무당이네, 나."
