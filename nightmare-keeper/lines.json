[
 {
  "id": "n1",
  "who": "narrator",
  "text": "이 마을 사람들은, 악몽을 꾸지 않습니다."
 },
 {
  "id": "n2",
  "who": "narrator",
  "text": "언덕 위 등불탑에서, 한 사람이 대신 지키고 있기 때문이죠."
 },
 {
  "id": "n3",
  "who": "narrator",
  "text": "잠든 사람에게서 새어 나온 나쁜 꿈은, 빛을 찾아 날아드는 나방이 됩니다."
 },
 {
  "id": "n4",
  "who": "narrator",
  "text": "파수꾼 노을은 밤마다 등불을 들고 골목을 돌며, 그 나방들을 거둬들입니다.",
  "asr": "파숙군 노을은 밤마다 등불을 들고 골목을 돌며 그 나방들을 걷어드립니다."
 },
 {
  "id": "k1",
  "who": "noeul",
  "text": "오늘 밤도, 무사히."
 },
 {
  "id": "n5",
  "who": "narrator",
  "text": "그런데 그날 밤은, 악몽이 너무 많았습니다."
 },
 {
  "id": "n6",
  "who": "narrator",
  "text": "흩어진 악몽들이, 잠든 집집마다 스며들었습니다."
 },
 {
  "id": "k2",
  "who": "noeul",
  "text": "하나도, 놓치지 않을 게다."
 },
 {
  "id": "n7",
  "who": "narrator",
  "text": "마지막 하나는, 마을 끝 오두막 지붕 위에 앉아 있었습니다."
 },
 {
  "id": "k3",
  "who": "noeul",
  "text": "이리 오너라. 무서울 것 없다."
 },
 {
  "id": "h1",
  "who": "haru",
  "text": "그건… 할머니 꿈이에요."
 },
 {
  "id": "n8",
  "who": "narrator",
  "text": "평생 남의 악몽을 지키느라, 파수꾼은 한 번도 잠든 적이 없었습니다."
 },
 {
  "id": "h2",
  "who": "haru",
  "text": "이번엔 제가 들고 있을게요."
 },
 {
  "id": "n9",
  "who": "narrator",
  "text": "그날 밤, 파수꾼은 처음으로 꿈을 꾸었습니다. 아주 좋은 꿈을.",
  "asr": "그날 밤 파숙구는 처음으로 꿈을 꾸었습니다. 아주 좋은 꿈을"
 },
 {
  "id": "h3",
  "who": "haru",
  "text": "오늘 밤은, 제가 지킬게요."
 }
]